@using QuizWebApp.Shared.Interfaces

@implements IDisposable

@inject IAppState AppState

@if (AppState.IsLoading)
{
    <div class="fullscreen d-flex justify-content-center align-items-center">
        <div class="overlay fullscreen"></div>
        <div class="bg-white p-3 shadow rounded" style="z-index: 9999">
            <span class="h5">@AppState.LoadingText</span>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnToggleLoader += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnToggleLoader -= StateHasChanged;
    }
}
