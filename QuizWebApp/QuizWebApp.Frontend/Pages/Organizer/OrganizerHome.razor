@page "/organizer/home"

@using QuizWebApp.Shared.DTOs.OrganizerHome

@inject IAppState AppState
@inject OrganizerClient OrganizerClient

<PageHeader Title="@PageTitle" />

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_summary is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="box p-3 rounded h-100 d-flex flex-column" style="background-color: rgba(21, 25, 29, 0.08);">
                <h4 class="fw-bold m-0">Participants</h4>
                <hr class="my-3" />
                <div class="mt-auto">
                    <h5 class="mb-2">@_summary.ParticipantsCount Total</h5>
                    <h5 class="m-0 text-success">@_summary.ApprovedParticipantsCount Approved</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="box p-3 rounded h-100 d-flex flex-column" style="background-color: rgba(21, 25, 29, 0.08);">
                <h4 class="fw-bold m-0">Topics</h4>
                <hr class="my-3" />
                <div class="mt-auto">
                    <h5 class="m-0">@_summary.TopicsCount Total</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="box p-3 rounded h-100 d-flex flex-column" style="background-color: rgba(21, 25, 29, 0.08);">
                <h4 class="fw-bold m-0">Quizzes</h4>
                <hr class="my-3" />
                <div class="mt-auto">
                    <h5 class="mb-2">@_summary.QuizzesCount Total</h5>
                    <h5 class="m-0 text-primary">@_summary.ActiveQuizzesCount Active</h5>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string PageTitle = "Home";

    private OrganizerHomeSummaryDTO? _summary;
    private string? _loadErrorMessage;

    protected override Task OnInitializedAsync()
        => AppState.HandleRequestAsync<OrganizerHomeSummaryDTO>
        (
            "Fetching summary...",
            () => OrganizerClient.GetHomeSummaryAsync(),
            data => _summary = data,
            errorMessage => _loadErrorMessage = errorMessage
        );
}
