@page "/organizer/manage-quizzes"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuizWebApp.Shared.DTOs.Quiz
@using QuizWebApp.Shared.DTOs.Topic
@using QuizWebApp.Shared.Enums
@using QuizWebApp.Shared.Extensions

@inject QuizzesClient QuizzesClient
@inject TopicsClient TopicsClient
@inject IAppState AppState

<PageHeader Title="@PageTitle" />

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_topics is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3 row">
        <div class="col-sm-3 ms-auto">
            <TopicFilter Topics="_topics" Label="Topic filter: "
                Placeholder="Type to filter by topic..." IsFilterRequired="false"
                @bind-TopicFilterId="_topicFilterId" 
                @bind-TopicFilterId:after="OnTopicFilterChanged" />
        </div>
    </div>
    <div class="row">
        <QuickGrid ItemsProvider="_quizzesProvider" Pagination="_paginationState"
            Class="table table-striped table-bordered table-hover" @ref="_grid">
            <PropertyColumn Property="@(quiz => quiz.Name)" />
            <PropertyColumn Property="@(quiz => quiz.Topic)" />
            <PropertyColumn Property="@(quiz => quiz.QuestionsNumber)" Title="Number of questions" />
            <PropertyColumn Property="@(quiz => quiz.TimeInMinutes)" Title="Time in minutes" />
            
            <TemplateColumn Title="Is active">
                @(context.IsActive ? "Yes" : "No")
            </TemplateColumn>
            
            <TemplateColumn Title="Actions">
                <div class="d-flex justify-content-around py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => ViewQuestions(context)">
                        View questions
                    </button>
                    <a class="btn btn-sm btn-secondary" href="organizer/manage-quizzes/@context.Id/attempts">
                        View attempts
                    </a>
                    <a class="btn btn-sm btn-primary" href="organizer/edit-quiz/@context.Id">
                        Edit
                    </a>
                </div>
            </TemplateColumn>
        </QuickGrid>
        <Paginator State="_paginationState" />
    </div>

    @if (_showQuestionsModal && _viewingQuestions is not null)
    {
        <QuizModal Title="Questions list" ActionButtonText="Ok" Size="ModalSize.Large"
            OnActionButtonClicked="() => _showQuestionsModal = false"
            OnCancelClicked="() => _showQuestionsModal = false">
            @foreach (string questionText in _viewingQuestions)
            {
                <div class="mb-3 shadow p-2 border">
                    @questionText
                </div>
            }
        </QuizModal>
    }
}

@code {
    private const string PageTitle = "Manage Quizzes";
    private const int DefaultPageSize = 10;
    private const int FirstPageIndex = 0;

    private QuickGrid<QuizSummaryInfoDTO>? _grid;
    private GridItemsProvider<QuizSummaryInfoDTO>? _quizzesProvider;
    private TopicInfoDTO[]? _topics;
    private string[]? _viewingQuestions;
    private string? _loadErrorMessage;

    private PaginationState _paginationState = new PaginationState { ItemsPerPage = DefaultPageSize };
    private int _topicFilterId;
    private bool _showQuestionsModal;

    protected override async Task OnInitializedAsync()
    {
        bool areTopicsReceived = await TopicsClient
            .GetTopicsAsync()
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching topics...",
                onSuccess: data => _topics = data.Data,
                onError: errorMessage => _loadErrorMessage = errorMessage
            );

        if (!areTopicsReceived) return;

        ConfigureQuizzesProvider();
    }

    private async Task OnTopicFilterChanged()
    {
        ArgumentNullException.ThrowIfNull(_grid);

        await _paginationState.SetCurrentPageIndexAsync(FirstPageIndex);
        await _grid.RefreshDataAsync();
    }

    private void ViewQuestions(QuizSummaryInfoDTO quizInfo)
    {
        _viewingQuestions = quizInfo.Questions.ToArray();
        _showQuestionsModal = true;
    }

    private void ConfigureQuizzesProvider()
    {
        _quizzesProvider = async request =>
        {
            if (_topicFilterId.ToTopicFilterStatus() == TopicFilterStatus.Invalid)
            {
                return GridItemsProviderResult.From(Array.Empty<QuizSummaryInfoDTO>(), 0);
            }

            return await QuizzesClient
                .GetQuizzesAsync(_topicFilterId, request.CreatePagination(DefaultPageSize))
                .HandleGridRequestAsync
                (
                    appState: AppState,
                    loaderMessage: "Fetching quizzes...",
                    onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
                );
        };
    }
}
