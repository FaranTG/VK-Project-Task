@page "/organizer/manage-quizzes"

@using QuizWebApp.Frontend.Clients
@using QuizWebApp.Frontend.Components
@using QuizWebApp.Shared.DTOs.Quiz
@using QuizWebApp.Shared.DTOs.Topic

@inject QuizzesClient QuizzesClient
@inject TopicsClient TopicsClient

@if (_topics is null || _quizzes is null || _filteredQuizzes is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h3>Manage Quizzes</h3>

    <hr />

    <div class="mb-3 row">
        <div class="col-sm-3 ms-auto">
            <label for="selectTopic" class="form-label">Topic Filter: </label>
            <select id="selectTopic" class="form-control" @bind="_selectedTopic" @bind:after="OnSelectedTopicChanged">
                <option value="0">Select Topic...</option>
                @foreach (TopicInfoDTO topic in _topics)
                {
                    <option value="@topic.Id">@topic.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Topic</th>
                    <th>Number of questions</th>
                    <th>Time in minutes</th>
                    <th>Is active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredQuizzes.Length == 0)
                {
                    <tr>
                        <td colspan="6">
                            <p class="text-danger h5"><em>No quizzes found.</em></p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (QuizBriefInfoDTO quizInfo in _filteredQuizzes)
                    {
                        <tr>
                            <td>@quizInfo.Name</td>
                            <td>@quizInfo.Topic</td>
                            <td>@quizInfo.QuestionsNumber</td>
                            <td>@quizInfo.TimeInMinutes</td>
                            <th>@quizInfo.IsActive</th>
                            <td>
                                <div class="d-flex justify-content-around">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ViewQuestions(quizInfo)">
                                        View questions
                                    </button>
                                    <a role="button" class="btn btn-sm btn-warning" href="organizer/edit-quiz/@quizInfo.Id">
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_showQuestionsModal && _viewingQuestions is not null)
    {
        <QuizModal Title="Questions list" ActionButtonText="Ok" Size="ModalSize.Large"
            OnActionButtonClicked="() => _showQuestionsModal = false"
            OnCancelClicked="() => _showQuestionsModal = false">
            @foreach (string questionText in _viewingQuestions)
            {
                <div class="mb-3 shadow p-2 border">
                    @questionText
                </div>
            }
        </QuizModal>
    }
}

@code {
    private QuizBriefInfoDTO[]? _quizzes;
    private QuizBriefInfoDTO[]? _filteredQuizzes;
    private TopicInfoDTO[]? _topics;
    private string[]? _viewingQuestions;
    private int _selectedTopic;
    private bool _showQuestionsModal;

    protected override async Task OnInitializedAsync()
    {
        _topics = await TopicsClient.GetTopicsAsync();
        _quizzes = await QuizzesClient.GetQuizzesAsync();
        _filteredQuizzes = _quizzes;
    }

    private void OnSelectedTopicChanged()
    {
        ArgumentNullException.ThrowIfNull(_quizzes);

        if (_selectedTopic == 0)
        {
            _filteredQuizzes = _quizzes;
            return;
        }

        _filteredQuizzes = _quizzes
            .Where(quizInfo => quizInfo.TopicId ==  _selectedTopic)
            .ToArray();
    }

    private void ViewQuestions(QuizBriefInfoDTO quizInfo)
    {
        _viewingQuestions = quizInfo.Questions.ToArray();
        _showQuestionsModal = true;
    }
}
