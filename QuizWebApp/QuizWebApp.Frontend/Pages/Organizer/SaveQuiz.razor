@page "/organizer/add-quiz"
@page "/organizer/edit-quiz/{id:guid}"

@using QuizWebApp.Frontend.Components
@using QuizWebApp.Shared.DTOs.Topic
@using QuizWebApp.Shared.DTOs.Quiz
@using QuizWebApp.Shared.DTOs.Question
@using QuizWebApp.Shared.DTOs.AnswerOption
@using QuizWebApp.Frontend.FormModels

@inject TopicsClient TopicsClient
@inject QuizzesClient QuizzesClient
@inject NavigationManager NavigationManager
@inject IAppState AppState

<PageHeader Title="@Title" />

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_quizModel is null || _topics is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm EditContext="_editContext" OnValidSubmit="SaveQuizAsync">
        <DataAnnotationsValidator />
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label for="name" class="form-label">Name: </label>
                    <InputText @bind-Value="_quizModel.Name" id="name" class="form-control" />
                    <ValidationMessage For="() => _quizModel.Name" />
                </div>
            </div>
            <div class="col-sm-3">
                <div class="mb-3">
                    <TopicFilter Topics="_topics" Label="Topic: "
                        Placeholder="Type to select topic..." IsFilterRequired="true"
                        @bind-TopicFilterId="_quizModel.TopicId"
                        @bind-TopicFilterId:after="OnTopicFilterChanged" />
        
                    <ValidationMessage For="() => _quizModel.TopicId" />
                </div>
            </div>
            <div class="col-sm-3">
                <div class="mb-3">
                    <label for="timeInMinutes" class="form-label">Time in minutes: </label>
                    <InputNumber @bind-Value="_quizModel.TimeInMinutes" id="timeInMinutes" class="form-control" />
                    <ValidationMessage For="() => _quizModel.TimeInMinutes" />
                </div>
            </div>

            <hr />
            
            <h5 class="mb-3 fw-bold">Questions</h5>
            <ol>
                @foreach (QuestionModel question in _quizModel.Questions)
                {
                    <li class="p-3 mb-3 rounded" style="background-color: rgba(21, 25, 29, 0.08);">
                        <textarea @bind="question.Text" class="form-control mb-3" rows="3"></textarea>
                        <h6 class="fw-bold">Options</h6>
                        <ol>
                            @foreach (AnswerOptionModel option in question.Options)
                            {
                                <li class="p-2 mb-2">
                                    <div class="input-group">
                                        <div class="input-group-text">
                                            <input name="@question.OptionName" class="form-check-input mt-0" 
                                                type="radio" checked="@option.IsCorrect"
                                                @onchange="() => SetCorrectOption(question, option)">
                                        </div>
                                        <input @bind="option.Text" type="text" class="form-control">
                                        <button class="btn btn-sm btn-danger" type="button" 
                                            @onclick="() => question.Options.Remove(option)">
                                            Delete
                                        </button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <div class="mt-3 d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-sm btn-primary" 
                                @onclick="() => question.Options.Add(new AnswerOptionModel() { Text = string.Empty })">
                                Add new option
                            </button>

                            @if (!IsEditCase)
                            {
                                <button type="button" class="btn btn-sm btn-danger" 
                                    @onclick="() => RemoveQuestion(question)">
                                    Delete Question
                                </button>
                            }
                        </div>
                    </li>
                }
            </ol>
            <div class="mb-3 d-flex justify-content-center">
                <button type="button" class="btn btn-primary" 
                    @onclick="() => _quizModel.Questions.Add(CreateEmptyQuestion())">
                    Add new question
                </button>
            </div>

            <hr />
        
            <div class="row mb-5 align-items-center">
                <div class="col-sm-2 ms-auto d-flex justify-content-end">
                    <div class="form-check form-switch">
                        <label class="form-check-label" for="isActive">Is active? </label>
                        <InputCheckbox @bind-Value="_quizModel.IsActive" id="isActive" class="form-check-input" type="checkbox" role="switch" />
                    </div>
                </div>
                <div class="col-sm-3 d-grid me-auto">
                    <button type="submit" class="btn btn-success">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private const string SaveQuizLoaderMessage = "Saving quiz...";

    private QuizModel? _quizModel;
    private EditContext? _editContext;
    private TopicInfoDTO[]? _topics;
    private string? _loadErrorMessage;
    private Guid? _lastProcessedId;

    private string Title => IsEditCase ? $"Edit Quiz" : "New Quiz";
    private bool IsEditCase => Id.HasValue && Id.Value != Guid.Empty;

    protected override Task OnInitializedAsync()
        => TopicsClient
            .GetTopicsAsync()
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching topics...",
                onSuccess: data => _topics = data.Data,
                onError: errorMessage => _loadErrorMessage = errorMessage
            );

    protected override async Task OnParametersSetAsync()
    {
        if (_quizModel is not null && _lastProcessedId == Id) return;

        _lastProcessedId = Id;

        if (IsEditCase)
        {
            bool isQuizFilled = await FillQuizAsync();
            if (!isQuizFilled) return;
        }
        else
        {
            CreateEmptyQuiz();
        }

        _editContext = new EditContext(_quizModel!);
    }

    private async Task SaveQuizAsync()
    {
        ArgumentNullException.ThrowIfNull(_quizModel);

        string? validationResult = _quizModel.Validate();
        if (!string.IsNullOrEmpty(validationResult))
        {
            AppState.ShowError(validationResult);
            return;
        } 

        QuizSaveDTO newQuiz = CreateQuizSaveDTO(_quizModel);
        bool isQuizSaved = await TrySendSaveRequestAsync(newQuiz);

        if (!isQuizSaved)
        {
            return;
        }

        NavigationManager.NavigateTo("organizer/manage-quizzes");
    }

    private Task<bool> TrySendSaveRequestAsync(QuizSaveDTO newQuiz)
        => (IsEditCase
            ? QuizzesClient.UpdateQuizAsync(Id!.Value, newQuiz)
            : QuizzesClient.AddQuizAsync(newQuiz).CastToBaseAsync())
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: SaveQuizLoaderMessage,
                onSuccess: null,
                onError: errorMessage => AppState.ShowError(errorMessage)
            );

    private void RemoveQuestion(QuestionModel question)
    {
        ArgumentNullException.ThrowIfNull(_quizModel);

        if (_quizModel.Questions.Count <= 1)
        {
            AppState.ShowError("A quiz must have at least one question.");
            return;
        }

        _quizModel.Questions.Remove(question);
    }

    private void SetCorrectOption(QuestionModel question, AnswerOptionModel correctOption)
    {
        foreach (AnswerOptionModel option in question.Options)
        {
            option.IsCorrect = false;
        }

        correctOption.IsCorrect = true;
    }

    

    private Task<bool> FillQuizAsync()
        => QuizzesClient
            .GetQuizByIdAsync(Id!.Value)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching quiz...",
                onSuccess: quizInfo => _quizModel = CreateQuizModel(quizInfo),
                onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
            );

    private void OnTopicFilterChanged()
    {
        if (_editContext is not null && _quizModel is not null)
        {
            FieldIdentifier fieldIdentifier = FieldIdentifier.Create(() => _quizModel.TopicId);
            _editContext.NotifyFieldChanged(fieldIdentifier);
        }
    }

    private void CreateEmptyQuiz()
    {
        _quizModel = new QuizModel()
        {
            Name = string.Empty,
            Questions = new List<QuestionModel>()
            {
                CreateEmptyQuestion()
            }
        };
    }

    private QuestionModel CreateEmptyQuestion()
    {
        return new QuestionModel()
        {
            Text = string.Empty,
            Options = new List<AnswerOptionModel>()
            {
                new AnswerOptionModel()
                {
                    Text = string.Empty,
                    IsCorrect = true
                },
                new AnswerOptionModel()
                {
                    Text = string.Empty,
                    IsCorrect = false
                }
            }
        };
    }

    private QuizModel CreateQuizModel(QuizInfoDTO quizInfo)
    {
        return new QuizModel()
        {
            Name = quizInfo.Name,
            TopicId = quizInfo.TopicId,
            TimeInMinutes = quizInfo.TimeInMinutes,
            IsActive = quizInfo.IsActive,
            Questions = quizInfo.Questions
                .Select
                (
                    questionInfo => new QuestionModel()
                    {
                        Text = questionInfo.Text,
                        Options = questionInfo.Options
                            .Select
                            (
                                optionInfo => new AnswerOptionModel()
                                {
                                    Text = optionInfo.Text,
                                    IsCorrect = optionInfo.IsCorrect
                                }
                            )
                            .ToList()
                    }
                )
                .ToList()
        };
    }

    private QuizSaveDTO CreateQuizSaveDTO(QuizModel model)
    {
        return new QuizSaveDTO
        (
            model.Name,
            model.TopicId,
            model.TimeInMinutes,
            model.IsActive,
            model.Questions
                .Select
                (
                    questionModel => new QuestionSaveDTO
                    (
                        questionModel.Text,
                        questionModel.Options
                            .Select
                            (
                                optionModel => new AnswerOptionSaveDTO
                                (
                                    optionModel.Text,
                                    optionModel.IsCorrect
                                )
                            )
                            .ToList()
                    )
                )
                .ToList()
        );
    } 
}
