@page "/organizer/manage-users"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuizWebApp.Frontend.Clients
@using QuizWebApp.Frontend.Extensions
@using QuizWebApp.Shared.ApiResponses
@using QuizWebApp.Shared.DTOs.User

@inject UsersClient UsersClient
@inject IAppState AppState

<SectionContent SectionName="pageTitle">Manage Users</SectionContent>

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger mb-3"><em>Error: @_loadErrorMessage</em></p>
}

<div class="row">
    <div class="col-sm-4 ms-auto mb-3">
        <label class="form-label" for="filter">Status filter: </label>
        <select class="form-select" @bind="_isApprovedFilter" id="filter" @bind:after="OnFilterChangedAsync">
            <option value="">Select status...</option>
            
            <option value="@ApprovedValue">Approved</option>
            
            <option value="@NotApprovedValue">Not Approved</option>
        </select>
    </div>
</div>
<div class="row">
    <QuickGrid ItemsProvider="_usersProvider" Pagination="_paginationState" 
        Class="table table-striped table-bordered table-hover mb-3" @ref="_grid">
        <PropertyColumn Property="user => user.Id" />
        <PropertyColumn Property="user => user.Name" />
        <PropertyColumn Property="user => user.Phone" />
        <PropertyColumn Property="user => user.Email" />
        <PropertyColumn Property="user => user.Role" />
        <TemplateColumn Title="Is Approved?">
            <div class="form-check form-switch">
                <label class="form-check-label" for="u_@context.Id">
                    @(context.IsApproved ? "Yes" : "No")
                </label>
                <input id="u_@context.Id" class="form-check-input" type="checkbox" role="switch"
                    checked="@context.IsApproved" @onchange="() => OnUserApprovedToggleAsync(context.Id)"/>
            </div>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="_paginationState" />
</div>

@code {
    private const string ApprovedValue = "approved";
    private const string NotApprovedValue = "not-approved";
    private const int DefaultPageSize = 10;
    private const int FirstPageIndex = 0;

    private QuickGrid<UserInfoDTO>? _grid;
    private GridItemsProvider<UserInfoDTO>? _usersProvider;
    private string? _loadErrorMessage;
    private string _isApprovedFilter = string.Empty;

    private PaginationState _paginationState = new PaginationState { ItemsPerPage = DefaultPageSize };

    protected override void OnInitialized()
    {
        _usersProvider = async request =>
        {
            AppState.ShowLoader("Fetching users...");

            try
            {
                QuizApiResponse<PagedInfo<UserInfoDTO>> response = await UsersClient
                    .GetUsersAsync(request.CreatePagination(DefaultPageSize), ConvertFilter());

                if (response.IsSuccess)
                {
                    return GridItemsProviderResult.From(response.Data!.DTOs, response.Data.TotalCount);
                }

                _loadErrorMessage = response.ErrorMessage;
                StateHasChanged();
                return GridItemsProviderResult.From(Array.Empty<UserInfoDTO>(), 0);
            }
            finally
            {
                AppState.HideLoader();
            }
        };
    }

    private async Task OnUserApprovedToggleAsync(int id)
    {
        AppState.ShowLoader("Updating user approved status...");

        try
        {
            QuizApiResponse response = await UsersClient.ToggleUserApprovedStatusAsync(id);

            if (response.IsSuccess)
            {
                ArgumentNullException.ThrowIfNull(_grid);
                await _grid.RefreshDataAsync();
                return;
            }

            _loadErrorMessage = response.ErrorMessage;
            StateHasChanged();
        }
        finally
        {
            AppState.HideLoader();
        }
    }

    private async Task OnFilterChangedAsync()
    {
        ArgumentNullException.ThrowIfNull(_grid);

        await _paginationState.SetCurrentPageIndexAsync(FirstPageIndex);
        await _grid.RefreshDataAsync();
    }

    private bool? ConvertFilter()
    {
        return _isApprovedFilter switch
        {
            ApprovedValue => true,
            NotApprovedValue => false,
            _ => null
        };
    }
}
