@page "/organizer/manage-quizzes/{id:guid}/attempts"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuizWebApp.Shared.DTOs.Attempt
@using QuizWebApp.Shared.DTOs.Filter

@inject QuizzesClient QuizzesClient
@inject AttemptsClient AttemptsClient
@inject IAppState AppState

<PageHeader Title="@PageTitle" />

<div class="mb-3 col-sm-12 d-flex gap-5 h5">
    <p><strong>Quiz:</strong> @_quizName</p>
    <p><strong>Topic:</strong> @_topicName</p>
</div>

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger mb-3"><em>Error: @_loadErrorMessage</em></p>
}
else
{
    <AttemptsFilterPanel Placeholder="Type participant name or email..." 
        @bind-Filter="_filterData" @bind-Filter:after="OnFilterChanged" />
}

<div class="row">
    <QuickGrid ItemsProvider="_attemptsProvider" Pagination="_paginationState" Class="table table-striped table-bordered table-hover mb-3" @ref="_grid">
        <PropertyColumn Property="attempt => attempt.ParticipantName" Title="Participant Name" />
        <PropertyColumn Property="attempt => attempt.ParticipantEmail" Title="Participant Email" />
        <PropertyColumn Property="attempt => attempt.Status" />
        <PropertyColumn Property="attempt => attempt.StartTime.ToLocalTime()" Title="Start Time" Format="@DateFormat" />
        <TemplateColumn Title="End Time">
            @if (context.Status == nameof(AttemptStatus.Started))
            {
                <span>-</span>
            }
            else
            {
                <span>@context.EndTime.ToLocalTime().ToString(DateFormat)</span>
            }
        </TemplateColumn>
        <PropertyColumn Property="attempt => attempt.Score" Class="text-center" />
    </QuickGrid>
    <Paginator State="_paginationState" />
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }
    
    private const string PageTitle = "View Quiz Attempts";
    private const string DateFormat = "dd.MM.yyyy HH:mm";
    private const int DefaultPageSize = 10;
    private const int FirstPageIndex = 0;

    private QuickGrid<AttemptParticipantInfoDTO>? _grid;
    private GridItemsProvider<AttemptParticipantInfoDTO>? _attemptsProvider;
    private string? _loadErrorMessage;
    private string? _quizName;
    private string? _topicName;
    private Guid? _previousId;

    private PaginationState _paginationState = new PaginationState { ItemsPerPage = DefaultPageSize };
    private AttemptFilterDTO _filterData = new AttemptFilterDTO(SearchFilter: null, StatusFilter: null);

    protected override void OnInitialized()
    {
        ConfigureAttemptsProvider();
    }

    protected override Task OnParametersSetAsync()
    {
        if (_previousId == Id) return Task.CompletedTask;
        _previousId = Id;

        return QuizzesClient
            .GetQuizTitleByIdAsync(Id!.Value)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching quiz title...",
                onSuccess: data => { _quizName = data.Name; _topicName = data.Topic; },
                onError: errorMessage => _loadErrorMessage = errorMessage
            );
    }

    private async Task OnFilterChanged()
    {
        ArgumentNullException.ThrowIfNull(_grid);

        await _paginationState.SetCurrentPageIndexAsync(FirstPageIndex);
        await _grid.RefreshDataAsync();
    }

    private void ConfigureAttemptsProvider()
    {
        _attemptsProvider = async request =>
            await AttemptsClient
                .GetQuizAttemptsAsync(Id!.Value, request.CreatePagination(DefaultPageSize), _filterData)
                .HandleGridRequestAsync
                (
                    appState: AppState,
                    loaderMessage: "Fetching attempts...",
                    onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
                );
    }
}
