@page "/organizer/manage-topics"

@using QuizWebApp.Shared.DTOs.Topic
@using QuizWebApp.Frontend.FormModels
@using QuizWebApp.Frontend.Clients
@using QuizWebApp.Shared.ApiResponses

@inject TopicsClient TopicsClient
@inject IAppState AppState

<SectionContent SectionName="pageTitle">Manage Topics</SectionContent>

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_topics is null || TopicModel is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-sm-4">
            <EditForm Model="TopicModel" OnValidSubmit="SaveTopicAsync">
                <DataAnnotationsValidator />

                <div class="card">
                    <div class="card-header">
                        <h5 class="m-0">@TopicCardTitle</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="topicName" class="form-label">Name: </label>
                            <InputText @bind-Value="TopicModel.Name" id="topicName" class="form-control" />
                            <ValidationMessage For="() => TopicModel.Name" />
                        </div>

                        @if (_formErrorMessage is not null)
                        {
                            <div class="d-flex justify-content-between align-items-center gap-2 border border-danger border-1 p-1">
                                <p class="m-0">@_formErrorMessage</p>
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => _formErrorMessage = null">Close</button>
                            </div>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="ClearModel">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-sm btn-primary">
                            Save
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="col-sm-7 ms-auto">
            <table class="table table-striped table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_topics.Length == 0)
                    {
                        <tr>
                            <td colspan="4">
                                <p class="h5 text-center text-danger"><em>No topics found.</em></p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNumber = 1;
                        @foreach (TopicInfoDTO topicData in _topics)
                        {
                            <tr>
                                <td>@(rowNumber++)</td>
                                <td>@topicData.Id</td>
                                <td>@topicData.Name</td>
                                <td>
                                    <div class="d-flex">
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SetTopic(topicData)">
                                            Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private TopicModel? TopicModel { get; set; }

    private TopicInfoDTO[]? _topics;
    private string? _loadErrorMessage;
    private string? _formErrorMessage;
    private int? _id;

    private string TopicCardTitle => _id is null ? "New Topic" : $"Edit Topic with Id {_id}";

    protected override async Task OnInitializedAsync()
    {
        await LoadTopicsAsync();

        TopicModel = new () { Name = string.Empty };
    }

    private void SetTopic(TopicInfoDTO topicData)
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        _formErrorMessage = null;
        _id = topicData.Id;
        TopicModel.Name = topicData.Name;
    }

    private async Task SaveTopicAsync()
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        _formErrorMessage = null;

        AppState.ShowLoader("Saving topic...");

        TopicSaveDTO newTopic = new TopicSaveDTO(TopicModel.Name);
        
        bool isSuccess = await TrySendRequstAsync(newTopic);
        if (isSuccess)
        {
            ClearModel();
            await LoadTopicsAsync();
        }
        
        AppState.HideLoader();
    }

    private async Task<bool> TrySendRequstAsync(TopicSaveDTO newTopic)
    {
        if (_id is null)
        {
            QuizApiResponse<TopicInfoDTO>? response = await TopicsClient.AddTopicAsync(newTopic);

            if (response.IsFailure)
            {
                _formErrorMessage = response.ErrorMessage;
                return false;
            }
        }
        else
        {
            QuizApiResponse? response = await TopicsClient.UpdateTopicAsync(_id.Value, newTopic);

            if (response.IsFailure)
            {
                _formErrorMessage = response.ErrorMessage;
                return false;
            }
        }
        
        return true;
    }

    private async Task LoadTopicsAsync()
    {
        AppState.ShowLoader("Fetching topics...");
        
        QuizApiResponse<TopicInfoDTO[]>? response = await TopicsClient.GetTopicsAsync();

        if (response.IsSuccess)
        {
            _topics = response.Data;
        }
        else
        {
            _loadErrorMessage = response.ErrorMessage;
        }

        AppState.HideLoader();
    }

    private void ClearModel()
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        _id = null;
        TopicModel.Name = string.Empty;
        _formErrorMessage = null;
    }
}
