@page "/organizer/manage-topics"

@using Microsoft.AspNetCore.Components.QuickGrid
@using QuizWebApp.Frontend.FormModels
@using QuizWebApp.Shared.DTOs.Filter
@using QuizWebApp.Shared.DTOs.Topic

@inject TopicsClient TopicsClient
@inject IAppState AppState

<PageHeader Title="@PageTitle" />

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (TopicModel is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-sm-4">
            <EditForm Model="TopicModel" OnValidSubmit="SaveTopicAsync">
                <DataAnnotationsValidator />

                <div class="card">
                    <div class="card-header">
                        <h5 class="m-0">@TopicCardTitle</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="topicName" class="form-label">Name: </label>
                            <InputText @bind-Value="TopicModel.Name" id="topicName" class="form-control" />
                            <ValidationMessage For="() => TopicModel.Name" />
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="ClearModel">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-sm btn-primary">
                            Save
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="col-sm-7 ms-auto">
            <div class="row mb-3">
                <div class="col-12">
                    <SearchFilter Label="Search topics: " Placeholder="Type topic name..."
                        @bind-Value="_searchFilter" @bind-Value:after="OnFilterChanged" />
                </div>
            </div>
            
            <QuickGrid ItemsProvider="_topicsProvider" Pagination="_paginationState" 
                Class="table table-striped table-bordered table-hover" @ref="_grid">
                <PropertyColumn Property="topic => topic.Id" />
                <PropertyColumn Property="topic => topic.Name" />
                
                <TemplateColumn Title="Actions">
                    <div class="d-flex py-1">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SetTopic(context)">
                            Edit
                        </button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
            <Paginator State="_paginationState" />
        </div>
    </div>
}

@code {
    private const string PageTitle = "Manage Topics";
    private const string SaveTopicLoaderMessage = "Saving topic...";
    private const int DefaultPageSize = 10;
    private const int FirstPageIndex = 0;

    private TopicModel? TopicModel { get; set; }

    private QuickGrid<TopicInfoDTO>? _grid;
    private GridItemsProvider<TopicInfoDTO>? _topicsProvider;
    private string? _loadErrorMessage;
    private string? _searchFilter;
    private int? _id;

    private PaginationState _paginationState = new PaginationState { ItemsPerPage = DefaultPageSize };

    private string TopicCardTitle => _id is null ? "New Topic" : $"Edit Topic with Id {_id}";

    protected override void OnInitialized()
    {
        TopicModel = new () { Name = string.Empty };

        ConfigureTopicsProvider();
    }

    private async Task SaveTopicAsync()
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        TopicSaveDTO newTopic = new TopicSaveDTO(TopicModel.Name);

        bool isTopicSaved = await TrySendSaveRequestAsync(newTopic);

        if (!isTopicSaved) return;

        ClearModel();
        ArgumentNullException.ThrowIfNull(_grid);
        await _grid.RefreshDataAsync();
    }

    private Task<bool> TrySendSaveRequestAsync(TopicSaveDTO newTopic)
        => (_id is null
            ? TopicsClient.AddTopicAsync(newTopic).CastToBaseAsync()
            : TopicsClient.UpdateTopicAsync(_id.Value, newTopic))
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: SaveTopicLoaderMessage,
                onSuccess: null,
                onError: errorMessage => AppState.ShowError(errorMessage)
            );

    private void SetTopic(TopicInfoDTO topicData)
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        _id = topicData.Id;
        TopicModel.Name = topicData.Name;
    }

    private void ClearModel()
    {
        ArgumentNullException.ThrowIfNull(TopicModel);

        _id = null;
        TopicModel.Name = string.Empty;
    }

    private async Task OnFilterChanged()
    {
        ArgumentNullException.ThrowIfNull(_grid);

        await _paginationState.SetCurrentPageIndexAsync(FirstPageIndex);
        await _grid.RefreshDataAsync();
    }

    private void ConfigureTopicsProvider()
    {
        _topicsProvider = async request =>
            await TopicsClient
                .GetTopicsAsync(request.CreatePagination(DefaultPageSize), new TopicFilterDTO(_searchFilter))
                .HandleGridRequestAsync
                (
                    appState: AppState,
                    loaderMessage: "Fetching topics...",
                    onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
                );
    }
}
