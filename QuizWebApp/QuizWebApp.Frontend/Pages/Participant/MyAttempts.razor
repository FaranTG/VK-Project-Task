@page "/participant/my-attempts"
@using Microsoft.AspNetCore.Components.QuickGrid
@using QuizWebApp.Frontend.Clients
@using QuizWebApp.Frontend.Extensions
@using QuizWebApp.Shared.ApiResponses
@using QuizWebApp.Shared.DTOs.Attempt
@using QuizWebApp.Shared.DTOs.Common

@inject AttemptsClient AttemptsClient
@inject IAppState AppState

<SectionContent SectionName="pageTitle">My Attempts</SectionContent>

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger mb-3"><em>Error: @_loadErrorMessage</em></p>
}

<div class="row">
    <QuickGrid ItemsProvider="_attemptsProvider" Pagination="_paginationState" Class="table table-striped table-bordered table-hover mb-3">
        <PropertyColumn Property="attempt => attempt.QuizName" Title="Quiz Name" />
        <PropertyColumn Property="attempt => attempt.TopicName" Title="Topic Name" />
        <PropertyColumn Property="attempt => attempt.Status" />
        <PropertyColumn Property="attempt => attempt.StartTime" Title="Start Time" Format="@DateFormat" />
        <TemplateColumn Title="End Time">
            @if (context.Status == nameof(AttemptStatus.Started))
            {
                <span>-</span>
            }
            else
            {
                <span>@context.EndTime.ToString(DateFormat)</span>
            }
        </TemplateColumn>
        <PropertyColumn Property="attempt => attempt.Score" Class="text-center" />
    </QuickGrid>
    <Paginator State="_paginationState" />
</div>

@code {
    private const string DateFormat = "dd.MM.yyyy HH:mm";
    private const int DefaultPageSize = 10;

    private GridItemsProvider<AttemptQuizInfoDTO>? _attemptsProvider;
    private string? _loadErrorMessage;

    private PaginationState _paginationState = new PaginationState { ItemsPerPage = DefaultPageSize };

    protected override void OnInitialized()
    {
        _attemptsProvider = async request =>
        {
            AppState.ShowLoader("Fetching attempts...");

            try
            {
                QuizApiResponse<PagedInfo<AttemptQuizInfoDTO>> response = await AttemptsClient
                    .GetParticipantAttemptsAsync(request.CreatePagination(DefaultPageSize));
                
                if (response.IsSuccess)
                {
                    return GridItemsProviderResult.From(response.Data!.DTOs, response.Data.TotalCount);
                }

                _loadErrorMessage = response.ErrorMessage;
                StateHasChanged();
                return GridItemsProviderResult.From(Array.Empty<AttemptQuizInfoDTO>(), 0);
            }
            finally
            {
                AppState.HideLoader();
            }
        };
    }
}
