@page "/participant/home"

@using QuizWebApp.Shared.DTOs.Common
@using QuizWebApp.Shared.DTOs.Filter
@using QuizWebApp.Shared.DTOs.Quiz
@using QuizWebApp.Shared.Extensions

@inject AttemptsClient AttemptsClient
@inject QuizzesClient QuizzesClient
@inject TopicsClient TopicsClient
@inject IAppState AppState
@inject QuizState QuizState
@inject NavigationManager NavigationManager

<PageHeader Title="@PageTitle" />

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_quizzes is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <QuizzesFilterPanel @bind-Filter="_filterData" 
        @bind-Filter:after="OnFilterChanged" 
        OnErrorReceived="errorMessage => _loadErrorMessage = errorMessage" />
    <div class="row">
        @if (_quizzes.Length == 0)
        {
            <p class="h5 text-center text-danger"><em>@NoFoundMessage</em></p>
        }
        else
        {
            foreach (QuizBriefInfoDTO quiz in _quizzes)
            {
                <div class="col-sm-4 mb-3">
                    <div class="box p-3 rounded" style="background-color: rgba(21, 25, 29, 0.08);">
                        <h5 class="fw-bold">@quiz.Name</h5>
                        <hr />
                        <table class="table">
                            <tr>
                                <td>
                                    <label class="fw-bold">Topic</label>
                                </td>
                                <td>
                                    @quiz.Topic
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold">Number of questions</label>
                                </td>
                                <td>
                                    @quiz.QuestionsNumber
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold">Time in minutes</label>
                                </td>
                                <td>
                                    @quiz.TimeInMinutes
                                </td>
                            </tr>
                        </table>
                        <hr />
                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => _selectedQuiz = quiz">Start Quiz</button>
                    </div>
                </div>
            }

            @if (TotalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-2 mb-5">
                    <button class="btn btn-sm btn-outline-secondary" 
                            disabled="@IsFirstPage" 
                            @onclick="GoToFirstPage">|◄</button>
                    
                    <button class="btn btn-sm btn-outline-secondary" 
                            disabled="@IsFirstPage" 
                            @onclick="GoToPreviousPage">◄</button>
                    
                    <span class="mx-2 fw-semibold">Page <strong>@_currentPage</strong> of <strong>@TotalPages</strong></span>
                    
                    <button class="btn btn-sm btn-outline-secondary" 
                            disabled="@IsLastPage" 
                            @onclick="GoToNextPage">►</button>
                    
                    <button class="btn btn-sm btn-outline-secondary" 
                            disabled="@IsLastPage" 
                            @onclick="GoToLastPage">►|</button>
                </div>
            }
        }
    </div>

    @if (_selectedQuiz is not null)
    {
        string title = $"Start {_selectedQuiz.Name}?";
        <QuizModal Title="@title" ActionButtonText="Start"
            OnActionButtonClicked="StartSelectedQuiz"
            OnCancelClicked="() => _selectedQuiz = null">
            <p class="m-0 p-3">
                Do you want to start this quiz?
                <br />
                You will not be able to pause it once started.
            </p>
        </QuizModal>
    }
}

@code {
    private const string PageTitle = "Home";
    private const int DefaultPageSize = 6;
    private const int FirstPageNumber = 1;

    private QuizBriefInfoDTO[]? _quizzes;
    private QuizBriefInfoDTO? _selectedQuiz;
    private string? _loadErrorMessage;
    private int _currentPage = FirstPageNumber;
    private int _totalItemsCount = 0;

    private QuizFilterDTO _filterData = new QuizFilterDTO(SearchFilter: null, TopicFilterId: 0);
    private string NoFoundMessage => _filterData.TopicFilterId.ToTopicFilterStatus() == TopicFilterStatus.Valid 
        ? "No active quizzes found for the selected topic."
        : "No active quizzes found.";
    private int TotalPages => (int)Math.Ceiling((double)_totalItemsCount / DefaultPageSize);
    private bool IsFirstPage => _currentPage == FirstPageNumber;
    private bool IsLastPage => _currentPage >= TotalPages;

    protected override async Task OnInitializedAsync()
    {
        await FetchQuizzesAsync();
    }

    private async Task OnFilterChanged()
    {
        _currentPage = FirstPageNumber; 
        await FetchQuizzesAsync();
    }

    private Task FetchQuizzesAsync()
    {
        if (_filterData.TopicFilterId.ToTopicFilterStatus() == TopicFilterStatus.Invalid)
        {
            _quizzes = [];
            _totalItemsCount = 0;
            return Task.CompletedTask;
        }

        PaginationDTO paginationData = new PaginationDTO(_currentPage, DefaultPageSize);

        return QuizzesClient
            .GetActiveBriefQuizzesAsync(paginationData, _filterData)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching quizzes...",
                onSuccess: data => { _quizzes = data.Data; _totalItemsCount = data.TotalCount; },
                onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
            );
    }

    private async Task GoToFirstPage() => await GoToPage(IsFirstPage, FirstPageNumber);

    private async Task GoToPreviousPage() => await GoToPage(IsFirstPage, _currentPage - 1);

    private async Task GoToNextPage() => await GoToPage(IsLastPage, _currentPage + 1);

    private async Task GoToLastPage() => await GoToPage(IsLastPage, TotalPages);

    private async Task GoToPage(bool returnCondition, int newPageNumber)
    {
        if (returnCondition) return;

        _currentPage = newPageNumber;
        await FetchQuizzesAsync();
    }

    private Task StartSelectedQuiz()
    {
        ArgumentNullException.ThrowIfNull(_selectedQuiz);

        return AttemptsClient
            .StartQuizAsync(_selectedQuiz.Id)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Preparing the quiz...",
                onSuccess: attemptId =>
                {
                    QuizState.SetSelectedQuiz(_selectedQuiz, attemptId);
                    NavigationManager.NavigateTo("/participant/take-quiz");
                },
                onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
            );
    }
}
