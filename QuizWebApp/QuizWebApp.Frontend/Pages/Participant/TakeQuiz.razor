@page "/participant/take-quiz"
@layout AttemptLayout

@using QuizWebApp.Shared.DTOs.AnswerOption
@using QuizWebApp.Shared.DTOs.Question

@inject QuizState QuizState
@inject NavigationManager NavigationManager
@inject AttemptsClient ParticipantQuizzesClient
@inject IAppState AppState

<PageTitle>@QuizState.SelectedQuiz?.Name</PageTitle>
<SectionContent SectionName="pageTitle">
    Quiz - @QuizState.SelectedQuiz?.Name [<small>@QuizState.SelectedQuiz?.QuestionsNumber question(s)</small>]
</SectionContent>

@if (_loadErrorMessage is not null)
{
    <p class="h5 text-center text-danger"><em>Error: @_loadErrorMessage</em></p>
}
else if (_questionData is null || QuizState.SelectedQuiz is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row mb-3">
        <div class="col-sm-12">
            <div class="my-1 d-flex justify-content-between align-items-center">
                <h6>@(_completedQuestionsNumber + 1) of @QuizState.SelectedQuiz.QuestionsNumber</h6>

                @if (_submitErrorMessage is null && _submitQuizMessage is null)
                {
                    <QuizTimer TotalMinutes="QuizState.SelectedQuiz.TimeInMinutes" OnTimeElapsed="AutoSubmitQuizAsync" />
                }
                else
                {
                    <p>Finished</p>
                }
            </div>
            <h4 class="mt-3 mb-0 fw-bold">@_questionData.Text</h4>
            <hr />
            @foreach (AnswerOptionInfoDTO option in _questionData.Options)
            {
                <div class="d-flex gap-2 p-3 mb-3 option-box" @onclick="() => _selectedOptionId = option.Id">
                    <label for="rdo_@option.Id" class="d-block">@option.Text</label>
                    <input type="radio" class="" name="rdo_@_questionData.Id" id="rdo_@option.Id"
                        checked="@(_selectedOptionId == option.Id)"
                        @onchange="() => _selectedOptionId = option.Id" />
                </div>
            }
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-danger" @onclick="() => _showExitQuizConfirmation = true">Exit Quiz</button>
                @if (IsLastQuestion)
                {
                    <button type="button" class="btn btn-success" @onclick="SubmitQuizAsync">Submit Quiz</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="GoNextQuestionAsync">Save & Next</button>
                }
            </div>
        </div>

        @if (_submitQuizMessage is not null)
        {
            <QuizModal Title="Quiz Submitted" ActionButtonText="Ok"
                OnActionButtonClicked="RedirectToMyQuizzes"
                OnCancelClicked="RedirectToMyQuizzes">
                <p class="text-success h5">
                    @_submitQuizMessage
                </p>
            </QuizModal>
        }

        @if (_showExitQuizConfirmation)
        {
            <QuizModal Title="Confirm Exit" ActionButtonText="Yes"
                OnActionButtonClicked="ExitQuizAsync"
                OnCancelClicked="() => _showExitQuizConfirmation = false">
                <p class="text-danger h5">
                    Do you really want to exit the quiz?
                </p>
            </QuizModal>
        }

        @if (_submitErrorMessage is not null)
        {
            <QuizModal Title="Submit Error" ActionButtonText="Ok"
                OnActionButtonClicked="RedirectToMyQuizzes"
                OnCancelClicked="RedirectToMyQuizzes">
                <p class="text-danger h5">
                    @_submitErrorMessage
                </p>
            </QuizModal>
        }
    </div>
}

@code {
    private QuestionInfoDTO? _questionData;
    private string? _loadErrorMessage;
    private string? _submitErrorMessage;
    private string? _submitQuizMessage;
    private int _selectedOptionId;
    private int _completedQuestionsNumber;
    private bool _showExitQuizConfirmation;

    private bool IsLastQuestion => _completedQuestionsNumber == ((QuizState.SelectedQuiz?.QuestionsNumber ?? 0) - 1);

    protected override async Task OnInitializedAsync()
    {
        if (!QuizState.IsQuizSelected)
        {
            NavigationManager.NavigateTo("/participant/home", replace: true);
            return;
        }

        await LoadNextQuestionAsync();
    }

    private Task ExitQuizAsync()
        => ParticipantQuizzesClient
            .ExitQuizAsync(QuizState.AttemptId)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Exiting the quiz...",
                onSuccess: RedirectToMyQuizzes,
                onError: errorMessage => 
                {
                    _showExitQuizConfirmation = false;
                    AppState.ShowError(errorMessage);
                }
            );

    private async Task GoNextQuestionAsync()
    {
        if (_selectedOptionId == 0)
        {
            AppState.ShowError("Option not selected.");
            return;
        }

        bool isSaved = await SaveQuestionAsync();
        if (!isSaved) return;

        bool isLoaded = await LoadNextQuestionAsync();
        if (isLoaded) ++_completedQuestionsNumber;
    }

    private async Task SubmitQuizAsync()
    {
        if (_selectedOptionId == 0)
        {
            AppState.ShowError("Option not selected.");
            return;
        }

        bool isSaved = await SaveQuestionAsync();
        if (!isSaved) return;

        await CompleteQuizAsync();
    }

    private Task AutoSubmitQuizAsync()
        => ParticipantQuizzesClient
            .AutoSubmitQuizAsync(QuizState.AttemptId)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Auto-submitting the quiz...",
                onSuccess: () => _submitQuizMessage = "Quiz auto-submitted successfully",
                onError: errorMessage => _submitErrorMessage = errorMessage
            );

    private Task<bool> LoadNextQuestionAsync()
        => ParticipantQuizzesClient
            .GetQuizNextQuestionAsync(QuizState.AttemptId)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Fetching question...",
                onSuccess: data => 
                {
                    _selectedOptionId = 0;
                    _questionData = data;
                },
                onError: errorMessage => { _loadErrorMessage = errorMessage; StateHasChanged(); }
            );

    private Task<bool> SaveQuestionAsync()
        => ParticipantQuizzesClient
            .SaveQuestionResponseAsync(QuizState.AttemptId, CreateResponseDTO())
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Sending question response...",
                onSuccess: null,
                onError: errorMessage => AppState.ShowError(errorMessage)
            );

    private Task CompleteQuizAsync()
        => ParticipantQuizzesClient
            .CompleteQuizAsync(QuizState.AttemptId)
            .HandleRequestAsync
            (
                appState: AppState,
                loaderMessage: "Submitting the quiz...",
                onSuccess: () => _submitQuizMessage = "Quiz submitted successfully",
                onError: errorMessage => _submitErrorMessage = errorMessage
            );

    private QuestionResponseSaveDTO CreateResponseDTO()
    {
        ArgumentNullException.ThrowIfNull(_questionData);

        return new QuestionResponseSaveDTO 
        (
            QuizState.AttemptId,
            _questionData.Id,
            _selectedOptionId
        );
    }

    private void RedirectToMyQuizzes()
    {
        QuizState.ResetSelectedQuiz();
        NavigationManager.NavigateTo("/participant/my-attempts", replace: true);
    }
}
