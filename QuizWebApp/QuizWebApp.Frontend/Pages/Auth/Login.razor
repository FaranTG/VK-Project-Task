@page "/auth/login"
@layout AuthLayout

@using QuizWebApp.Frontend.FormModels
@using QuizWebApp.Shared.DTOs.User
@using QuizWebApp.Frontend.Auth
@using QuizWebApp.Shared

@inject AuthClient AuthClient
@inject QuizAuthStateProvider QuizAuthStateProvider
@inject NavigationManager NavigationManager
@inject IAppState AppState

@if (LoginModel is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row vh-100">
        <div class="col-sm-4 mx-auto my-auto border shadow-lg">
            <h3 class="mt-3 fw-bold">Login | Quiz</h3>
            <hr />
            <EditForm Model="LoginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="username" class="form-label">Username: </label>
                    <InputText @bind-Value="LoginModel.Username" id="username" class="form-control" />
                    <ValidationMessage For="() => LoginModel.Username" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password: </label>
                    <InputText @bind-Value="LoginModel.Password" type="password" id="password" class="form-control" />
                    <ValidationMessage For="() => LoginModel.Password" />
                </div>

                <div class="mb-3 d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a class="btn btn-outline-primary" href="auth/register">Register</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private LoginModel? LoginModel { get; set; }

    protected override void OnInitialized()
    {
        if (QuizAuthStateProvider.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        LoginModel = new ()
        {
            Username = string.Empty,
            Password = string.Empty
        };
    }

    private async Task LoginAsync() {
        ArgumentNullException.ThrowIfNull(LoginModel);

        AppState.ShowLoader("Logging-in...");
        try 
        {
            QuizApiResponse<LoggedInUserInfo> response = await AuthClient.AddUserTokenAsync(CreateLoginDTO(LoginModel));

            if (response.IsFailure) {
                AppState.ShowError(response.ErrorMessage!);
                return;
            }

            ArgumentNullException.ThrowIfNull(response.Data);
            LoggedInUserInfo user = response.Data;
            await QuizAuthStateProvider.SetLoginAsync(user);

            NavigationManager.NavigateTo("/");
        }
        finally
        {
            AppState.HideLoader();
        }
    }

    private UserLoginDTO CreateLoginDTO(LoginModel model) {
        if (model.Username is null || model.Password is null) 
        {
            throw new ArgumentException("Username or password is null");
        }

        return new (model.Username, model.Password);
    }
}
