@page "/"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using QuizWebApp.Frontend.Auth
@using QuizWebApp.Frontend.Components
@using QuizWebApp.Shared.Enums

@inject QuizAuthStateProvider QuizAuthStateProvider

@attribute [Authorize]

<AuthorizeView>
    <Authorizing>
        <p><em>Authorizing...</em></p>
    </Authorizing>
    <Authorized>
        <AuthorizeView Roles="@nameof(UserRole.Organizer)" Context="organizerContext">
            <RedirectTo Url="/organizer/home" />
        </AuthorizeView>
        <AuthorizeView Roles="@nameof(UserRole.Participant)" Context="participantContext">
            <RedirectTo Url="/participant/home" />
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

@code {
}