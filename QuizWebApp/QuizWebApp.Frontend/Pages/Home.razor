@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@using QuizWebApp.Frontend.Auth
@using System.Security.Claims

@inject QuizAuthStateProvider QuizAuthStateProvider

<PageTitle>Home</PageTitle>
<SectionContent SectionName="pageTitle">Home</SectionContent>

<h4>@GetWelcomeMessage()</h4>

<AuthorizeView>
    <Authorizing>
        <p><em>Authorizing...</em></p>
    </Authorizing>
    <NotAuthorized>
        <p><em>Not Authorized</em></p>
    </NotAuthorized>
    <Authorized>
        <p><em>Authorized: @context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value</em></p>
    </Authorized>
</AuthorizeView>

@code {
    private string GetWelcomeMessage() => QuizAuthStateProvider.IsLoggedIn ? 
        $"Hello, {QuizAuthStateProvider.User!.Name}!" 
        : "Hello, Anonymous!";
}